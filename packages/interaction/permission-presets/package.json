{
  "name": "@master-harness/permission-presets",
  "description": "User-facing permission presets (ctx.permissionPresets) for the Master Harness: one product-level Permissions select bundling the sandbox-mode and approval-policy knobs, written through to their own session events",
  "version": "0.2.1-rc.3",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hadimaster65555/deepseek-harness-master-ver.git",
    "directory": "packages/interaction/permission-presets"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./types": {
      "types": "./lib/types/types.d.ts",
      "default": "./lib/types/types.js"
    },
    "./client": {
      "types": "./lib/types/client.d.ts",
      "default": "./lib/types/client.js"
    },
    "./typert": {
      "types": "./lib/typert.host.d.ts",
      "default": "./lib/typert.host.js"
    },
    "./remote": {
      "types": "./lib/typert.remote-client.d.ts",
      "default": "./lib/typert.remote-client.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts",
    "lib/typert.host.js",
    "lib/typert.host.d.ts",
    "lib/typert.remote-client.js",
    "lib/typert.remote-client.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@master-harness/agent": "workspace:*",
    "@master-harness/shell": "workspace:*",
    "@master-harness/commands": "workspace:*",
    "@master-harness/sandbox": "workspace:*",
    "@master-harness/sandbox-policy": "workspace:*",
    "@master-harness/session": "workspace:*",
    "@master-harness/session-projection": "workspace:*",
    "@master-harness/typert-protocol": "workspace:*",
    "@master-harness/user-approval": "workspace:*",
    "@master-harness/cordis": "workspace:~"
  },
  "dependencies": {
    "@master-harness/schemastery": "workspace:~",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@master-harness/agent": "workspace:*",
    "@master-harness/shell": "workspace:*",
    "@master-harness/commands": "workspace:*",
    "@master-harness/sandbox": "workspace:*",
    "@master-harness/sandbox-policy": "workspace:*",
    "@master-harness/session": "workspace:*",
    "@master-harness/session-projection": "workspace:*",
    "@master-harness/typert-protocol": "workspace:*",
    "@master-harness/user-approval": "workspace:*",
    "@master-harness/cordis": "workspace:~",
    "@master-harness/settings": "workspace:*",
    "@master-harness/agent-loop-testkit": "workspace:*"
  }
}
