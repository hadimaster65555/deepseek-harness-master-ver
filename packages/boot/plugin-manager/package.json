{
  "name": "@master-harness/plugin-manager",
  "description": "Current-profile plugin and bundle management shared by mh CLI, Web and agent tools",
  "version": "0.2.1-rc.3",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hadimaster65555/deepseek-harness-master-ver.git",
    "directory": "packages/boot/plugin-manager"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./types": {
      "types": "./lib/types/types.d.ts",
      "default": "./lib/types/types.js"
    },
    "./registry": {
      "types": "./lib/types/registry.d.ts",
      "default": "./lib/types/registry.js"
    },
    "./typert": {
      "types": "./lib/typert.host.d.ts",
      "default": "./lib/typert.host.js"
    },
    "./remote": {
      "types": "./lib/typert.remote-client.d.ts",
      "default": "./lib/typert.remote-client.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./operations": {
      "types": "./lib/types/operations.d.ts",
      "default": "./lib/types/operations.js"
    },
    "./tools": {
      "types": "./lib/types/tools.d.ts",
      "default": "./lib/types/tools.js"
    },
    "./tools/locale/*.json": "./locale/tools/*.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "locale/*.json",
    "locale/tools/*.json",
    "lib/index.js",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts",
    "lib/typert.host.js",
    "lib/typert.host.d.ts",
    "lib/typert.remote-client.js",
    "lib/typert.remote-client.d.ts"
  ],
  "license": "MIT",
  "dependencies": {
    "@master-harness/app-boot": "workspace:*",
    "@master-harness/atomic-write": "workspace:*",
    "@master-harness/official-bundles": "workspace:*",
    "@master-harness/schemastery": "workspace:~",
    "execa": "^10.0.1",
    "semver": "^7.8.5",
    "yaml": "^2.9.0",
    "zod": "4.4.3",
    "@master-harness/util-values": "workspace:*",
    "@master-harness/plugin-detail": "workspace:*",
    "@master-harness/timeout": "workspace:*",
    "hosted-git-info": "^9.0.3"
  },
  "peerDependencies": {
    "@master-harness/cordis": "workspace:~",
    "@master-harness/cordis-plugin-loader": "workspace:~",
    "@master-harness/host-plugin-inventory": "workspace:*",
    "@master-harness/subprocess": "workspace:*",
    "@master-harness/typert-protocol": "workspace:*",
    "@master-harness/tools": "workspace:*",
    "@master-harness/hmr": "workspace:*",
    "@master-harness/brand": "workspace:*",
    "@master-harness/sandbox-policy": "workspace:*",
    "@master-harness/sandbox": "workspace:*",
    "@master-harness/user-approval": "workspace:*"
  },
  "peerDependenciesMeta": {
    "@master-harness/hmr": {
      "optional": true
    },
    "@master-harness/user-approval": {
      "optional": true
    }
  },
  "devDependencies": {
    "chokidar": "^4.0.3",
    "@types/semver": "^7.8.0",
    "@master-harness/package-manifest": "workspace:*",
    "@master-harness/cordis": "workspace:~",
    "@master-harness/cordis-plugin-loader": "workspace:~",
    "@master-harness/host-plugin-inventory": "workspace:*",
    "@master-harness/subprocess": "workspace:*",
    "@master-harness/typert-protocol": "workspace:*",
    "@master-harness/tool-executor-native": "workspace:*",
    "@master-harness/tool-testkit": "workspace:*",
    "@master-harness/tools": "workspace:*",
    "@master-harness/system-prompt": "workspace:*",
    "@master-harness/hmr": "workspace:*",
    "@master-harness/cordis-plugin-timer": "workspace:~",
    "@master-harness/brand": "workspace:*",
    "@master-harness/sandbox-policy": "workspace:*",
    "@master-harness/agent": "workspace:*",
    "@master-harness/session": "workspace:*",
    "@master-harness/session-projection": "workspace:*",
    "@master-harness/sandbox": "workspace:*",
    "@master-harness/user-approval": "workspace:*",
    "@master-harness/client-connection": "workspace:*",
    "@types/hosted-git-info": "^3.0.5"
  }
}
