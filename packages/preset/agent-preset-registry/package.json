{
  "name": "@master-harness/agent-preset-registry",
  "description": "Declarative Agent preset registry and profile-backed editing",
  "version": "0.2.1-rc.3",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hadimaster65555/deepseek-harness-master-ver.git",
    "directory": "packages/preset/agent-preset-registry"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./types": {
      "types": "./lib/types/types.d.ts",
      "default": "./lib/types/types.js"
    },
    "./display": {
      "types": "./lib/types/display.d.ts",
      "default": "./lib/types/display.js"
    },
    "./typert": {
      "types": "./lib/typert.host.d.ts",
      "default": "./lib/typert.host.js"
    },
    "./remote": {
      "types": "./lib/typert.remote-client.d.ts",
      "default": "./lib/typert.remote-client.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts",
    "lib/typert.host.js",
    "lib/typert.host.d.ts",
    "lib/typert.remote-client.js",
    "lib/typert.remote-client.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@master-harness/cordis-plugin-include": "workspace:~",
    "@master-harness/cordis-plugin-loader": "workspace:~",
    "@master-harness/agent": "workspace:*",
    "@master-harness/scope": "workspace:*",
    "@master-harness/session": "workspace:*",
    "@master-harness/session-projection": "workspace:*",
    "@master-harness/settings": "workspace:*",
    "@master-harness/system-prompt": "workspace:*",
    "@master-harness/tools": "workspace:*",
    "@master-harness/typert-protocol": "workspace:*",
    "@master-harness/cordis": "workspace:~"
  },
  "dependencies": {
    "@master-harness/app-boot": "workspace:*",
    "@master-harness/schemastery": "workspace:~",
    "zod": "4.4.3",
    "js-yaml": "^4.3.2"
  },
  "devDependencies": {
    "@master-harness/cordis-plugin-group": "workspace:~",
    "@master-harness/cordis-plugin-include": "workspace:~",
    "@master-harness/cordis-plugin-loader": "workspace:~",
    "@master-harness/agent": "workspace:*",
    "@master-harness/agent-loop": "workspace:*",
    "@master-harness/atomic-write": "workspace:*",
    "@master-harness/llm": "workspace:*",
    "@master-harness/scope": "workspace:*",
    "@master-harness/session": "workspace:*",
    "@master-harness/session-projection": "workspace:*",
    "@master-harness/settings": "workspace:*",
    "@master-harness/system-prompt": "workspace:*",
    "@master-harness/tool-executor-native": "workspace:*",
    "@master-harness/tool-executor-ptc": "workspace:*",
    "@master-harness/tool-testkit": "workspace:*",
    "@master-harness/tools": "workspace:*",
    "@master-harness/typert-protocol": "workspace:*",
    "@master-harness/cordis": "workspace:~",
    "@master-harness/fs-local": "workspace:*",
    "@master-harness/hmr": "workspace:*",
    "@master-harness/ptc-runtime": "workspace:*",
    "@master-harness/sandbox": "workspace:*",
    "@master-harness/sandbox-policy": "workspace:*",
    "@master-harness/user-approval": "workspace:*",
    "@master-harness/agent-preset": "workspace:*",
    "@master-harness/working-directory": "workspace:*",
    "@types/js-yaml": "^4.0.9"
  }
}
