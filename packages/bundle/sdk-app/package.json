{
  "name": "@master-harness/sdk-app",
  "description": "The mh SDK profile bundle: stdio JSON-RPC serving and process lifecycle over mh-base",
  "version": "0.2.1-rc.3",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hadimaster65555/deepseek-harness-master-ver.git",
    "directory": "packages/bundle/sdk-app"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./src/*": "./src/*",
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "cordis.patch.yml",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "mh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "dependencies": {
    "@master-harness/cmdline": "workspace:*",
    "@master-harness/sdk-jsonrpc-server": "workspace:*",
    "@master-harness/schemastery": "workspace:~",
    "commander": "^15.0.0",
    "@master-harness/skill-office": "workspace:*",
    "@master-harness/tool-workspace-dependencies": "workspace:*",
    "@master-harness/client-connection": "workspace:*",
    "@master-harness/client-file-upload": "workspace:*",
    "@master-harness/workspace": "workspace:*",
    "@master-harness/schedule": "workspace:*",
    "@master-harness/time-context": "workspace:*",
    "@master-harness/tool-schedule": "workspace:*",
    "@master-harness/tool-ask-user": "workspace:*",
    "@master-harness/tool-present": "workspace:*",
    "@master-harness/file-reference-local": "workspace:*",
    "@master-harness/deliverable-file-references": "workspace:*"
  },
  "peerDependencies": {
    "@master-harness/cordis": "workspace:~"
  },
  "devDependencies": {
    "@master-harness/cordis-plugin-include": "workspace:~",
    "@master-harness/cordis": "workspace:~"
  }
}
