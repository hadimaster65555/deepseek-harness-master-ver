{
  "name": "@master-harness/headless",
  "description": "The mh one-shot bundle: a direct core Agent/Session runner over mh-base with no Host, HTTP, or browser layer",
  "version": "0.2.1-rc.3",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hadimaster65555/deepseek-harness-master-ver.git",
    "directory": "packages/bundle/headless"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./startup": {
      "types": "./lib/types/startup.d.ts",
      "default": "./lib/startup.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./src/*": "./src/*",
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/startup.js",
    "cordis.patch.yml",
    "lib/json-stream-*.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "mh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "dependencies": {
    "@master-harness/brand": "workspace:*",
    "@master-harness/cmdline": "workspace:*",
    "@master-harness/util-values": "workspace:*",
    "@master-harness/schemastery": "workspace:~",
    "commander": "^15.0.0"
  },
  "peerDependencies": {
    "@master-harness/cordis": "workspace:~",
    "@master-harness/cordis-plugin-loader": "workspace:~",
    "@master-harness/agent": "workspace:*",
    "@master-harness/agent-default-model": "workspace:*",
    "@master-harness/llm": "workspace:*",
    "@master-harness/session": "workspace:*",
    "@master-harness/session-query": "workspace:*",
    "@master-harness/fs": "workspace:*",
    "@master-harness/permission-presets": "workspace:*",
    "@master-harness/sandbox-policy": "workspace:*",
    "@master-harness/subagent": "workspace:*",
    "@master-harness/user-approval": "workspace:*"
  },
  "devDependencies": {
    "@master-harness/cordis": "workspace:~",
    "@master-harness/cordis-plugin-loader": "workspace:~",
    "@master-harness/agent": "workspace:*",
    "@master-harness/agent-default-model": "workspace:*",
    "@master-harness/agent-loop": "workspace:*",
    "@master-harness/agent-loop-testkit": "workspace:*",
    "@master-harness/llm": "workspace:*",
    "@master-harness/session": "workspace:*",
    "@master-harness/session-query": "workspace:*",
    "@master-harness/fs": "workspace:*",
    "@master-harness/permission-presets": "workspace:*",
    "@master-harness/sandbox-policy": "workspace:*",
    "@master-harness/subagent": "workspace:*",
    "@master-harness/user-approval": "workspace:*"
  },
  "peerDependenciesMeta": {
    "@master-harness/permission-presets": {
      "optional": true
    },
    "@master-harness/sandbox-policy": {
      "optional": true
    },
    "@master-harness/subagent": {
      "optional": true
    }
  }
}
