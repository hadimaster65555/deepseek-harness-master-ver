{
  "name": "@master-harness/sdk-minimal",
  "description": "The standalone minimal SDK profile bundle: JSON-RPC, one DeepSeek adapter, persistent shell, and JSONL sessions",
  "version": "0.2.1-rc.3",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hadimaster65555/deepseek-harness-master-ver.git",
    "directory": "packages/bundle/sdk-minimal"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "cordis.patch.yml",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "mh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "dependencies": {
    "@master-harness/cordis-plugin-timer": "workspace:~",
    "@master-harness/agent": "workspace:*",
    "@master-harness/agent-loop": "workspace:*",
    "@master-harness/attachment-local": "workspace:*",
    "@master-harness/compaction-basic": "workspace:*",
    "@master-harness/compaction-image-offload": "workspace:*",
    "@master-harness/deepseek-llm-api-extensions": "workspace:*",
    "@master-harness/jobs-local": "workspace:*",
    "@master-harness/llm": "workspace:*",
    "@master-harness/llm-deepseek-api-key": "workspace:*",
    "@master-harness/llm-retry": "workspace:*",
    "@master-harness/mcp-resources": "workspace:*",
    "@master-harness/plugin-package-inventory-deepseek": "workspace:*",
    "@master-harness/sandbox-local": "workspace:*",
    "@master-harness/sandbox-policy": "workspace:*",
    "@master-harness/sdk-app": "workspace:*",
    "@master-harness/sdk-jsonrpc-server": "workspace:*",
    "@master-harness/session": "workspace:*",
    "@master-harness/session-checkpoint-policy": "workspace:*",
    "@master-harness/session-log-deepseek": "workspace:*",
    "@master-harness/session-persistence-jsonl": "workspace:*",
    "@master-harness/session-projection": "workspace:*",
    "@master-harness/session-title": "workspace:*",
    "@master-harness/subprocess-local": "workspace:*",
    "@master-harness/system-prompt": "workspace:*",
    "@master-harness/terminal": "workspace:*",
    "@master-harness/terminal-bash": "workspace:*",
    "@master-harness/token-meter": "workspace:*",
    "@master-harness/tool-bash-persistent": "workspace:*",
    "@master-harness/tool-executor-native": "workspace:*",
    "@master-harness/tool-fs": "workspace:*",
    "@master-harness/tool-pwsh-persistent": "workspace:*",
    "@master-harness/tools": "workspace:*",
    "@master-harness/working-directory": "workspace:*",
    "@master-harness/tool-working-directory": "workspace:*",
    "@master-harness/fs-local": "workspace:*"
  },
  "peerDependencies": {
    "@master-harness/cordis": "workspace:~"
  },
  "devDependencies": {
    "@master-harness/cordis": "workspace:~"
  }
}
