{
  "name": "@master-harness/terminal-bash",
  "description": "Persistent shell PTY backend over the Master Harness subprocess terminal primitive",
  "version": "0.2.1-rc.3",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hadimaster65555/deepseek-harness-master-ver.git",
    "directory": "packages/terminal/terminal-bash"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@master-harness/agent": "workspace:*",
    "@master-harness/terminal": "workspace:*",
    "@master-harness/sandbox": "workspace:*",
    "@master-harness/sandbox-policy": "workspace:*",
    "@master-harness/session": "workspace:*",
    "@master-harness/subprocess": "workspace:*",
    "@master-harness/cordis": "workspace:~",
    "@master-harness/working-directory": "workspace:*"
  },
  "dependencies": {
    "@master-harness/lazy-require": "workspace:*",
    "@master-harness/pwsh-local": "workspace:*",
    "@master-harness/schemastery": "workspace:~",
    "@xterm/headless": "^6.0.0"
  },
  "devDependencies": {
    "@master-harness/agent": "workspace:*",
    "@master-harness/agent-loop-testkit": "workspace:*",
    "@master-harness/terminal": "workspace:*",
    "@master-harness/sandbox": "workspace:*",
    "@master-harness/sandbox-policy": "workspace:*",
    "@master-harness/session": "workspace:*",
    "@master-harness/session-projection": "workspace:*",
    "@master-harness/subprocess": "workspace:*",
    "@master-harness/subprocess-local": "workspace:*",
    "@master-harness/cordis": "workspace:~",
    "@master-harness/working-directory": "workspace:*"
  }
}
