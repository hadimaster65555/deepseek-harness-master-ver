{
  "name": "@master-harness/web-deepseek-api",
  "description": "DeepSeek Search and Fetch API providers for the Master Harness web capability seam (ctx.web)",
  "version": "0.2.1-rc.3",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hadimaster65555/deepseek-harness-master-ver.git",
    "directory": "packages/web/web-deepseek-api"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@master-harness/agent": "workspace:*",
    "@master-harness/credentials": "workspace:*",
    "@master-harness/deepseek-account": "workspace:*",
    "@master-harness/launch-environment": "workspace:*",
    "@master-harness/session": "workspace:*",
    "@master-harness/web": "workspace:*",
    "@master-harness/cordis": "workspace:~"
  },
  "dependencies": {
    "@master-harness/schemastery": "workspace:~"
  },
  "devDependencies": {
    "@master-harness/agent": "workspace:*",
    "@master-harness/credentials": "workspace:*",
    "@master-harness/credentials-local": "workspace:*",
    "@master-harness/deepseek-account": "workspace:*",
    "@master-harness/launch-environment": "workspace:*",
    "@master-harness/session": "workspace:*",
    "@master-harness/session-projection": "workspace:*",
    "@master-harness/web": "workspace:*",
    "@master-harness/cordis": "workspace:~",
    "@master-harness/http-proxy": "workspace:*"
  },
  "peerDependenciesMeta": {
    "@master-harness/deepseek-account": {
      "optional": true
    }
  }
}
