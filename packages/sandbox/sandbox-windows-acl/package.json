{
  "name": "@master-harness/sandbox-windows-acl",
  "description": "Windows ACL write-restriction sandbox backend (restricted-token spawn with capability-SID write allowlist) for the Master Harness sandbox seam",
  "version": "0.2.1-rc.3",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hadimaster65555/deepseek-harness-master-ver.git",
    "directory": "packages/sandbox/sandbox-windows-acl"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./runner": {
      "types": "./lib/types/runner.d.ts",
      "default": "./lib/runner.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/runner.js",
    "lib/types-*.js",
    "assets",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@master-harness/cordis": "workspace:~",
    "@master-harness/skill": "workspace:*",
    "@master-harness/subprocess": "workspace:*"
  },
  "dependencies": {
    "@master-harness/lazy-require": "workspace:*",
    "@master-harness/win32-process": "workspace:*",
    "koffi": "3.1.1",
    "yaml": "^2.4.2"
  },
  "devDependencies": {
    "@master-harness/cordis-plugin-loader": "workspace:~",
    "@master-harness/cordis-plugin-include": "workspace:~",
    "@master-harness/pwsh-local": "workspace:*",
    "@master-harness/sandbox-local": "workspace:*",
    "@master-harness/cordis": "workspace:~",
    "@master-harness/skill": "workspace:*",
    "@master-harness/subprocess": "workspace:*",
    "@master-harness/subprocess-local": "workspace:*"
  }
}
