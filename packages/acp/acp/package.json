{
  "name": "@master-harness/acp",
  "description": "Automation-only Agent Client Protocol server for driving Master Harness agents over JSON-RPC stdio",
  "version": "0.2.1-rc.3",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hadimaster65555/deepseek-harness-master-ver.git",
    "directory": "packages/acp/acp"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "dependencies": {
    "@agentclientprotocol/sdk": "1.4.0",
    "@master-harness/brand": "workspace:*",
    "@master-harness/schemastery": "workspace:~"
  },
  "peerDependencies": {
    "@master-harness/cordis": "workspace:~",
    "@master-harness/agent": "workspace:*",
    "@master-harness/attachment": "workspace:*",
    "@master-harness/llm": "workspace:*",
    "@master-harness/mcp-client": "workspace:*",
    "@master-harness/session": "workspace:*",
    "@master-harness/session-persistence": "workspace:*",
    "@master-harness/token-meter": "workspace:*",
    "@master-harness/user-approval": "workspace:*"
  },
  "peerDependenciesMeta": {
    "@master-harness/token-meter": {
      "optional": true
    }
  },
  "devDependencies": {
    "@master-harness/cordis": "workspace:~",
    "@master-harness/agent": "workspace:*",
    "@master-harness/agent-loop": "workspace:*",
    "@master-harness/agent-loop-testkit": "workspace:*",
    "@master-harness/attachment": "workspace:*",
    "@master-harness/llm": "workspace:*",
    "@master-harness/mcp-client": "workspace:*",
    "@master-harness/session": "workspace:*",
    "@master-harness/session-persistence": "workspace:*",
    "@master-harness/session-persistence-jsonl": "workspace:*",
    "@master-harness/session-projection": "workspace:*",
    "@master-harness/subagent": "workspace:*",
    "@master-harness/token-meter": "workspace:*",
    "@master-harness/tool-testkit": "workspace:*",
    "@master-harness/tools": "workspace:*",
    "@master-harness/user-approval": "workspace:*"
  }
}
