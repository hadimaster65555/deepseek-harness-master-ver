{
  "name": "@master-harness/workspace-changes",
  "description": "Per-turn workspace file changes recorded from git working-tree snapshots and whole-file captures, with per-file comparisons, for the Master Harness",
  "version": "0.2.1-rc.3",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hadimaster65555/deepseek-harness-master-ver.git",
    "directory": "packages/deliverables/workspace-changes"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./types": {
      "types": "./lib/types/types.d.ts",
      "default": "./lib/types/types.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "license": "MIT",
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts"
  ],
  "dependencies": {
    "@master-harness/schemastery": "workspace:~",
    "diff": "^9.0.0"
  },
  "peerDependencies": {
    "@master-harness/cordis": "workspace:~",
    "@master-harness/agent": "workspace:*",
    "@master-harness/session": "workspace:*",
    "@master-harness/subprocess": "workspace:*",
    "@master-harness/tools": "workspace:*",
    "@master-harness/fs": "workspace:*"
  },
  "devDependencies": {
    "@master-harness/cordis": "workspace:~",
    "@master-harness/cordis-plugin-include": "workspace:~",
    "@master-harness/cordis-plugin-loader": "workspace:~",
    "@master-harness/agent": "workspace:*",
    "@master-harness/session": "workspace:*",
    "@master-harness/subprocess": "workspace:*",
    "@master-harness/subprocess-local": "workspace:*",
    "@master-harness/tools": "workspace:*",
    "@master-harness/llm": "workspace:*",
    "@master-harness/fs": "workspace:*",
    "@master-harness/fs-local": "workspace:*",
    "@master-harness/agent-loop-testkit": "workspace:*",
    "@master-harness/agent-loop": "workspace:*",
    "@master-harness/working-directory": "workspace:*",
    "@master-harness/tool-fs": "workspace:*",
    "@master-harness/tool-str-replace-editor": "workspace:*"
  }
}
