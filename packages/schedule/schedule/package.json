{
  "name": "@master-harness/schedule",
  "description": "Host-wide durable reminders with shared management and original-Session delivery",
  "version": "0.2.1-rc.3",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hadimaster65555/deepseek-harness-master-ver.git",
    "directory": "packages/schedule/schedule"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client.d.ts",
      "default": "./lib/types/client.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./typert": {
      "types": "./lib/typert.host.d.ts",
      "default": "./lib/typert.host.js"
    },
    "./remote": {
      "types": "./lib/typert.remote-client.d.ts",
      "default": "./lib/typert.remote-client.js"
    }
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts",
    "lib/typert.host.js",
    "lib/typert.host.d.ts",
    "lib/typert.remote-client.js",
    "lib/typert.remote-client.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@master-harness/agent": "workspace:*",
    "@master-harness/api-session-controller": "workspace:*",
    "@master-harness/brand": "workspace:*",
    "@master-harness/llm": "workspace:*",
    "@master-harness/session": "workspace:*",
    "@master-harness/session-persistence": "workspace:*",
    "@master-harness/session-projection": "workspace:*",
    "@master-harness/storage-domain": "workspace:*",
    "@master-harness/subagent": "workspace:*",
    "@master-harness/tools": "workspace:*",
    "@master-harness/typert-protocol": "workspace:*",
    "@master-harness/util-time": "workspace:*",
    "@master-harness/workspace": "workspace:*",
    "@master-harness/cordis": "workspace:~"
  },
  "dependencies": {
    "@master-harness/schemastery": "workspace:~",
    "@js-temporal/polyfill": "0.5.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@master-harness/cordis-plugin-loader": "workspace:~",
    "@master-harness/agent": "workspace:*",
    "@master-harness/agent-loop": "workspace:*",
    "@master-harness/agent-loop-testkit": "workspace:*",
    "@master-harness/api-session-controller": "workspace:*",
    "@master-harness/brand": "workspace:*",
    "@master-harness/llm": "workspace:*",
    "@master-harness/session": "workspace:*",
    "@master-harness/session-persistence": "workspace:*",
    "@master-harness/session-persistence-jsonl": "workspace:*",
    "@master-harness/session-projection": "workspace:*",
    "@master-harness/storage": "workspace:*",
    "@master-harness/storage-domain": "workspace:*",
    "@master-harness/storage-json": "workspace:*",
    "@master-harness/subagent": "workspace:*",
    "@master-harness/system-prompt": "workspace:*",
    "@master-harness/tool-executor-native": "workspace:*",
    "@master-harness/tools": "workspace:*",
    "@master-harness/typert-protocol": "workspace:*",
    "@master-harness/util-time": "workspace:*",
    "@master-harness/workspace": "workspace:*",
    "@master-harness/cordis": "workspace:~"
  }
}
