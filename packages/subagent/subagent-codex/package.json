{
  "name": "@master-harness/subagent-codex",
  "description": "One-shot Codex subagent provider over the official app-server protocol",
  "version": "0.2.1-rc.3",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hadimaster65555/deepseek-harness-master-ver.git",
    "directory": "packages/subagent/subagent-codex"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./cordis.patch.yml": "./cordis.patch.yml"
  },
  "files": [
    "icon.svg",
    "locale/*.json",
    "lib/index.js",
    "cordis.patch.yml",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "mh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "peerDependencies": {
    "@master-harness/cordis": "workspace:~",
    "@master-harness/llm": "workspace:*",
    "@master-harness/session": "workspace:*",
    "@master-harness/subagent": "workspace:*",
    "@master-harness/subprocess": "workspace:*",
    "@master-harness/timeout": "workspace:*"
  },
  "dependencies": {
    "@master-harness/brand": "workspace:*",
    "@master-harness/sdk-protocol": "workspace:*",
    "@master-harness/schemastery": "workspace:~",
    "@openai/codex": "0.153.4",
    "@master-harness/tool-subagent": "workspace:*"
  },
  "devDependencies": {
    "@master-harness/cordis": "workspace:~",
    "@master-harness/cordis-plugin-loader": "workspace:~",
    "@master-harness/agent": "workspace:*",
    "@master-harness/app-boot": "workspace:*",
    "@master-harness/llm": "workspace:*",
    "@master-harness/loader-smoke": "workspace:*",
    "@master-harness/session": "workspace:*",
    "@master-harness/session-checkpoint-policy": "workspace:*",
    "@master-harness/session-persistence-jsonl": "workspace:*",
    "@master-harness/session-projection": "workspace:*",
    "@master-harness/subagent": "workspace:*",
    "@master-harness/subprocess": "workspace:*",
    "@master-harness/subprocess-local": "workspace:*",
    "@master-harness/timeout": "workspace:*",
    "@master-harness/tool-jobs": "workspace:*",
    "@master-harness/tools": "workspace:*"
  },
  "icon": "./icon.svg"
}
