{
  "name": "@master-harness/working-directory",
  "description": "Session working directories with durable changes and model context",
  "version": "0.2.1-rc.3",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hadimaster65555/deepseek-harness-master-ver.git",
    "directory": "packages/session/working-directory"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@master-harness/cordis": "workspace:~",
    "@master-harness/agent": "workspace:*",
    "@master-harness/fs": "workspace:*",
    "@master-harness/llm": "workspace:*",
    "@master-harness/session": "workspace:*",
    "@master-harness/session-projection": "workspace:*",
    "@master-harness/system-prompt": "workspace:*"
  },
  "devDependencies": {
    "@master-harness/sandbox-policy": "workspace:*",
    "@master-harness/user-approval": "workspace:*",
    "@master-harness/cordis": "workspace:~",
    "@master-harness/agent": "workspace:*",
    "@master-harness/fs": "workspace:*",
    "@master-harness/llm": "workspace:*",
    "@master-harness/session": "workspace:*",
    "@master-harness/session-projection": "workspace:*",
    "@master-harness/system-prompt": "workspace:*",
    "@master-harness/agent-loop-testkit": "workspace:*",
    "@master-harness/fs-local": "workspace:*",
    "@master-harness/tool-testkit": "workspace:*",
    "@master-harness/tool-working-directory": "workspace:*",
    "@master-harness/tools": "workspace:*"
  },
  "dependencies": {
    "@master-harness/schemastery": "workspace:~",
    "zod": "^4.4.3"
  }
}
