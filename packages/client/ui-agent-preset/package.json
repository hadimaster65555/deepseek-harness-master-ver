{
  "name": "@master-harness/client-ui-agent-preset",
  "description": "Agent-preset surfaces: the default for later sessions, this session's seat, and the composition editor",
  "version": "0.2.1-rc.3",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hadimaster65555/deepseek-harness-master-ver.git",
    "directory": "packages/client/ui-agent-preset"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "mh": {
    "client": {
      "inject": [
        "@master-harness/api-session-controller",
        "@master-harness/client-connection",
        "@master-harness/client-locale",
        "@master-harness/client-ui-conversation",
        "@master-harness/client-ui-session",
        "@master-harness/client-ui-settings",
        "@master-harness/client-ui-workspace",
        "@master-harness/api-remotes"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "bundle": "tsdown",
    "watch": "tsdown --watch"
  },
  "license": "MIT",
  "peerDependencies": {
    "@master-harness/cordis": "workspace:~"
  },
  "devDependencies": {
    "@master-harness/cordis": "workspace:~",
    "@master-harness/agent-preset-registry": "workspace:*",
    "@master-harness/api-remotes": "workspace:*",
    "@master-harness/api-session-controller": "workspace:*",
    "@master-harness/client-connection": "workspace:*",
    "@master-harness/client-locale": "workspace:*",
    "@master-harness/client-product-analytics": "workspace:*",
    "@master-harness/client-store": "workspace:*",
    "@master-harness/client-test-runtime": "workspace:*",
    "@master-harness/client-ui-conversation": "workspace:*",
    "@master-harness/client-ui-plugin-manager": "workspace:*",
    "@master-harness/client-ui-primitives": "workspace:*",
    "@master-harness/client-ui-renderer": "workspace:*",
    "@master-harness/client-ui-session": "workspace:*",
    "@master-harness/client-ui-settings": "workspace:*",
    "@master-harness/client-ui-slots": "workspace:*",
    "@master-harness/client-ui-workspace": "workspace:*",
    "@master-harness/session": "workspace:*",
    "@master-harness/util-values": "workspace:*",
    "react": "^18.2.0"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/client.js",
    "lib/types/**/*.d.ts"
  ],
  "dependencies": {}
}
