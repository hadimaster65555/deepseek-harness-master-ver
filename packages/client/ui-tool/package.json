{
  "name": "@master-harness/client-ui-tool",
  "description": "Client Tool call-tree renderer and keyed per-tool presentation slot",
  "version": "0.2.1-rc.3",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hadimaster65555/deepseek-harness-master-ver.git",
    "directory": "packages/client/ui-tool"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "mh": {
    "client": {
      "inject": [
        "@master-harness/api-workspace-controller",
        "@master-harness/client-connection",
        "@master-harness/client-locale",
        "@master-harness/client-ui-conversation"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "bundle": "tsdown",
    "watch": "tsdown --watch"
  },
  "license": "MIT",
  "peerDependencies": {
    "@master-harness/cordis": "workspace:~"
  },
  "devDependencies": {
    "@master-harness/spill-policy": "workspace:*",
    "@master-harness/agent": "workspace:*",
    "@master-harness/llm": "workspace:*",
    "@master-harness/session": "workspace:*",
    "@master-harness/system-prompt": "workspace:*",
    "@master-harness/tool-testkit": "workspace:*",
    "@master-harness/tools": "workspace:*",
    "@master-harness/tool-executor-native": "workspace:*",
    "@master-harness/tool-executor-ptc": "workspace:*",
    "@master-harness/tool-jobs": "workspace:*",
    "@master-harness/tool-session-query": "workspace:*",
    "@master-harness/tool-terminal": "workspace:*",
    "@master-harness/spill": "workspace:*",
    "@master-harness/cordis": "workspace:~",
    "@master-harness/api-remotes": "workspace:*",
    "@master-harness/client-connection": "workspace:*",
    "@master-harness/client-locale": "workspace:*",
    "@master-harness/client-test-runtime": "workspace:*",
    "@master-harness/client-ui-conversation": "workspace:*",
    "@master-harness/client-ui-primitives": "workspace:*",
    "@master-harness/client-ui-slots": "workspace:*",
    "@testing-library/react": "^16.3.3",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "@master-harness/api-workspace-controller": "workspace:*",
    "@master-harness/client-ui-chat": "workspace:*",
    "@master-harness/client-ui-renderer": "workspace:*",
    "@master-harness/client-ui-session": "workspace:*",
    "@master-harness/util-values": "workspace:*",
    "@master-harness/util-workspace-path": "workspace:*",
    "@master-harness/attachment": "workspace:*",
    "clsx": "^2.0.0",
    "@master-harness/ptc-runtime": "workspace:*",
    "@master-harness/token-meter": "workspace:*",
    "@master-harness/user-questions": "workspace:*"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/client.js",
    "lib/types/**/*.d.ts"
  ]
}
