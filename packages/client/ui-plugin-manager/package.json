{
  "name": "@master-harness/client-ui-plugin-manager",
  "description": "Plugin management for the mh web client: the sidebar Plugins panel installs, enables, disables, retries, and composes installed plugin packages",
  "version": "0.2.1-rc.3",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hadimaster65555/deepseek-harness-master-ver.git",
    "directory": "packages/client/ui-plugin-manager"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./typert": {
      "types": "./lib/typert.host.d.ts",
      "default": "./lib/typert.host.js"
    },
    "./remote": {
      "types": "./lib/typert.remote-client.d.ts",
      "default": "./lib/typert.remote-client.js"
    },
    "./locale/*.json": "./locale/*.json"
  },
  "mh": {
    "client": {
      "inject": [
        "@master-harness/api-remotes",
        "@master-harness/client-locale",
        "@master-harness/client-ui-layout",
        "@master-harness/client-ui-sidebar"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "bundle": "tsdown",
    "watch": "tsdown --watch"
  },
  "license": "MIT",
  "peerDependencies": {
    "@master-harness/cordis": "workspace:~"
  },
  "devDependencies": {
    "@master-harness/cordis": "workspace:~",
    "@master-harness/api-remote-access": "workspace:*",
    "@master-harness/api-remotes": "workspace:*",
    "@master-harness/client-locale": "workspace:*",
    "@master-harness/client-store": "workspace:*",
    "@master-harness/client-test-runtime": "workspace:*",
    "@master-harness/client-ui-layout": "workspace:*",
    "@master-harness/client-ui-primitives": "workspace:*",
    "@master-harness/client-ui-renderer": "workspace:*",
    "@master-harness/client-ui-sidebar": "workspace:*",
    "@master-harness/client-ui-slots": "workspace:*",
    "@master-harness/official-bundles": "workspace:*",
    "@master-harness/package-manifest": "workspace:*",
    "@testing-library/react": "^16.3.3",
    "clsx": "^2.1.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "@master-harness/util-crypto": "workspace:*",
    "@master-harness/client-ui-settings": "workspace:*",
    "@master-harness/plugin-manager": "workspace:*",
    "@master-harness/client-product-analytics": "workspace:*"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/client.js",
    "lib/types/**/*.d.ts",
    "lib/typert.host.js",
    "lib/typert.host.d.ts",
    "lib/typert.remote-client.js",
    "lib/typert.remote-client.d.ts"
  ],
  "dependencies": {
    "@master-harness/timeout": "workspace:*",
    "@master-harness/schemastery": "workspace:~",
    "zod": "4.4.3",
    "@master-harness/typert-protocol": "workspace:*"
  }
}
