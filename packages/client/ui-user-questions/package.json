{
  "name": "@master-harness/client-ui-user-questions",
  "description": "Web ask_user_question composer takeover and plan-review presentation UI",
  "version": "0.2.1-rc.3",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hadimaster65555/deepseek-harness-master-ver.git",
    "directory": "packages/client/ui-user-questions"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "mh": {
    "client": {
      "inject": [
        "@master-harness/api-remotes",
        "@master-harness/api-session-controller",
        "@master-harness/client-locale",
        "@master-harness/client-ui-conversation",
        "@master-harness/client-ui-renderer",
        "@master-harness/client-ui-session",
        "@master-harness/client-ui-chat"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "bundle": "tsdown",
    "watch": "tsdown --watch"
  },
  "license": "MIT",
  "peerDependencies": {
    "@master-harness/cordis": "workspace:~"
  },
  "devDependencies": {
    "@master-harness/cordis": "workspace:~",
    "@master-harness/agent": "workspace:*",
    "@master-harness/api-remotes": "workspace:*",
    "@master-harness/api-session-controller": "workspace:*",
    "@master-harness/brand": "workspace:*",
    "@master-harness/client-locale": "workspace:*",
    "@master-harness/client-store": "workspace:*",
    "@master-harness/system-prompt": "workspace:*",
    "@master-harness/tool-executor-native": "workspace:*",
    "@master-harness/tools": "workspace:*",
    "@master-harness/user-questions": "workspace:*",
    "@master-harness/client-ui-primitives": "workspace:*",
    "@master-harness/client-ui-slots": "workspace:*",
    "@master-harness/client-ui-renderer": "workspace:*",
    "@master-harness/client-ui-session": "workspace:*",
    "@master-harness/typert-protocol": "workspace:*",
    "react": "^18.2.0",
    "@master-harness/client-ui-conversation": "workspace:*",
    "@master-harness/client-connection": "workspace:*",
    "@master-harness/session": "workspace:*",
    "clsx": "^2.0.0",
    "@master-harness/llm": "workspace:*",
    "@master-harness/client-ui-chat": "workspace:*",
    "@master-harness/client-ui-tool": "workspace:*",
    "@master-harness/tool-executor-ptc": "workspace:*"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/client.js",
    "lib/types/**/*.d.ts"
  ]
}
