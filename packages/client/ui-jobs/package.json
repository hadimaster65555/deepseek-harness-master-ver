{
  "name": "@master-harness/client-ui-jobs",
  "description": "Session-header background-job list with on-demand streaming record panels",
  "version": "0.2.1-rc.3",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "scripts": {
    "bundle": "tsdown",
    "watch": "tsdown --watch"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hadimaster65555/deepseek-harness-master-ver.git",
    "directory": "packages/client/ui-jobs"
  },
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "@master-harness/cordis": "workspace:~"
  },
  "devDependencies": {
    "@master-harness/cordis": "workspace:~",
    "@master-harness/api-job-controller": "workspace:*",
    "@master-harness/client-locale": "workspace:*",
    "@master-harness/client-test-runtime": "workspace:*",
    "@master-harness/client-ui-conversation": "workspace:*",
    "@master-harness/client-ui-primitives": "workspace:*",
    "@master-harness/client-ui-renderer": "workspace:*",
    "@master-harness/client-ui-session": "workspace:*",
    "@master-harness/client-ui-slots": "workspace:*",
    "@master-harness/jobs": "workspace:*",
    "@master-harness/session": "workspace:*",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/client.js",
    "lib/types/**/*.d.ts"
  ],
  "mh": {
    "client": {
      "inject": [
        "@master-harness/api-job-controller",
        "@master-harness/client-locale",
        "@master-harness/client-ui-conversation",
        "@master-harness/client-ui-primitives"
      ],
      "platform": "web"
    }
  }
}
