{
  "name": "@master-harness/client-ui-settings-models",
  "description": "Models settings and shared product-onboarding dialogs over existing settings and credential joins",
  "version": "0.2.1-rc.3",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hadimaster65555/deepseek-harness-master-ver.git",
    "directory": "packages/client/ui-settings-models"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "mh": {
    "client": {
      "inject": [
        "@master-harness/client-ui-settings",
        "@master-harness/client-locale",
        "@master-harness/api-remotes"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "bundle": "tsdown",
    "watch": "tsdown --watch"
  },
  "license": "MIT",
  "peerDependencies": {
    "@master-harness/cordis": "workspace:~"
  },
  "devDependencies": {
    "@master-harness/host-webserver": "workspace:*",
    "@master-harness/api-remotes": "workspace:*",
    "@master-harness/client-locale": "workspace:*",
    "@master-harness/client-store": "workspace:*",
    "@master-harness/client-test-runtime": "workspace:*",
    "@master-harness/client-ui-primitives": "workspace:*",
    "@master-harness/client-ui-settings": "workspace:*",
    "@master-harness/client-ui-slots": "workspace:*",
    "@master-harness/cordis": "workspace:~",
    "react": "^18.2.0",
    "@master-harness/client-ui-renderer": "workspace:*",
    "@master-harness/util-values": "workspace:*",
    "@master-harness/remote-mock": "workspace:*",
    "@master-harness/client-product-analytics": "workspace:*"
  },
  "dependencies": {
    "@master-harness/schemastery": "workspace:~"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/client.js",
    "lib/types/**/*.d.ts"
  ]
}
