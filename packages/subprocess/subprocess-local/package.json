{
  "name": "@master-harness/subprocess-local",
  "description": "Local-subprocess implementation of the Master Harness subprocess seam",
  "version": "0.2.1-rc.3",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hadimaster65555/deepseek-harness-master-ver.git",
    "directory": "packages/subprocess/subprocess-local"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./runner": {
      "types": "./lib/types/bin.d.ts",
      "default": "./lib/runner.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./output": {
      "types": "./lib/types/output.d.ts",
      "default": "./lib/output.js"
    },
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/runner.js",
    "lib/runner-*.js",
    "lib/output.js",
    "scripts/ensure-spawn-helper.mjs",
    "lib/types/**/*.d.ts"
  ],
  "scripts": {
    "postinstall": "node scripts/ensure-spawn-helper.mjs"
  },
  "license": "MIT",
  "peerDependencies": {
    "@master-harness/subprocess": "workspace:*",
    "@master-harness/timeout": "workspace:*",
    "@master-harness/cordis": "workspace:~"
  },
  "dependencies": {
    "@master-harness/lazy-require": "workspace:*",
    "@master-harness/win32-process": "workspace:*",
    "koffi": "3.1.1",
    "node-pty": "1.2.0-beta.15"
  },
  "devDependencies": {
    "@master-harness/loader-smoke": "workspace:*",
    "@master-harness/subprocess": "workspace:*",
    "@master-harness/timeout": "workspace:*",
    "@master-harness/cordis": "workspace:~"
  }
}
