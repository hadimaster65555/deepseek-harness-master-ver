{
  "name": "@master-harness/host-plugin-inventory",
  "description": "Read-only Remote projection of current Cordis Loader plugin state",
  "version": "0.2.1-rc.3",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hadimaster65555/deepseek-harness-master-ver.git",
    "directory": "packages/host/plugin-inventory"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./types": {
      "types": "./lib/types/types.d.ts",
      "default": "./lib/types/types.js"
    },
    "./typert": {
      "types": "./lib/typert.host.d.ts",
      "default": "./lib/typert.host.js"
    },
    "./remote": {
      "types": "./lib/typert.remote-client.d.ts",
      "default": "./lib/typert.remote-client.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts",
    "lib/typert.host.js",
    "lib/typert.host.d.ts",
    "lib/typert.remote-client.js",
    "lib/typert.remote-client.d.ts"
  ],
  "license": "MIT",
  "dependencies": {
    "zod": "4.4.3"
  },
  "peerDependencies": {
    "@master-harness/cordis-plugin-loader": "workspace:~",
    "@master-harness/agent-preset-registry": "workspace:*",
    "@master-harness/brand": "workspace:*",
    "@master-harness/typert-protocol": "workspace:*",
    "@master-harness/cordis": "workspace:~"
  },
  "peerDependenciesMeta": {
    "@master-harness/agent-preset-registry": {
      "optional": true
    }
  },
  "devDependencies": {
    "@master-harness/app-boot": "workspace:*",
    "@master-harness/package-manifest": "workspace:*",
    "@master-harness/cordis-plugin-loader": "workspace:~",
    "@master-harness/agent-preset-registry": "workspace:*",
    "@master-harness/brand": "workspace:*",
    "@master-harness/typert-protocol": "workspace:*",
    "@master-harness/cordis": "workspace:~"
  }
}
