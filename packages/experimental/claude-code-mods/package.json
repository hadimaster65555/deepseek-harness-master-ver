{
  "name": "@master-harness/experimental-claude-code-mods",
  "description": "Experimental bridge: load Claude Code mods (hooks modules) and run their hook chains on Master Harness extension points",
  "version": "0.2.1-rc.3",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hadimaster65555/deepseek-harness-master-ver.git",
    "directory": "packages/experimental/claude-code-mods"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./types": {
      "types": "./lib/types/types.d.ts",
      "default": "./lib/types/types.js"
    },
    "./testing": {
      "types": "./lib/types/testing.d.ts",
      "default": "./lib/types/testing.js"
    },
    "./typert": {
      "types": "./lib/typert.host.d.ts",
      "default": "./lib/typert.host.js"
    },
    "./remote": {
      "types": "./lib/typert.remote-client.d.ts",
      "default": "./lib/typert.remote-client.js"
    },
    "./examples/*": "./examples/*",
    "./src/*": "./src/*",
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts",
    "lib/typert.host.js",
    "lib/typert.host.d.ts",
    "lib/typert.remote-client.js",
    "lib/typert.remote-client.d.ts"
  ],
  "license": "MIT",
  "dependencies": {
    "@master-harness/util-crypto": "workspace:*",
    "@master-harness/util-values": "workspace:*",
    "@master-harness/schemastery": "workspace:~",
    "zod": "^4.4.3"
  },
  "peerDependencies": {
    "@master-harness/cordis": "workspace:~",
    "@master-harness/agent": "workspace:*",
    "@master-harness/commands": "workspace:*",
    "@master-harness/fs": "workspace:*",
    "@master-harness/llm": "workspace:*",
    "@master-harness/scope": "workspace:*",
    "@master-harness/session": "workspace:*",
    "@master-harness/storage-domain": "workspace:*",
    "@master-harness/subprocess": "workspace:*",
    "@master-harness/token-meter": "workspace:*",
    "@master-harness/tools": "workspace:*",
    "@master-harness/typert-protocol": "workspace:*",
    "@master-harness/user-questions": "workspace:*",
    "@master-harness/working-directory": "workspace:*"
  },
  "devDependencies": {
    "@master-harness/cordis": "workspace:~",
    "@master-harness/cordis-plugin-include": "workspace:~",
    "@master-harness/cordis-plugin-loader": "workspace:~",
    "@master-harness/agent": "workspace:*",
    "@master-harness/agent-loop": "workspace:*",
    "@master-harness/agent-loop-testkit": "workspace:*",
    "@master-harness/attachment": "workspace:*",
    "@master-harness/commands": "workspace:*",
    "@master-harness/fs": "workspace:*",
    "@master-harness/fs-local": "workspace:*",
    "@master-harness/llm": "workspace:*",
    "@master-harness/scope": "workspace:*",
    "@master-harness/session": "workspace:*",
    "@master-harness/session-projection": "workspace:*",
    "@master-harness/storage": "workspace:*",
    "@master-harness/storage-domain": "workspace:*",
    "@master-harness/storage-json": "workspace:*",
    "@master-harness/subprocess": "workspace:*",
    "@master-harness/subprocess-local": "workspace:*",
    "@master-harness/system-prompt": "workspace:*",
    "@master-harness/token-meter": "workspace:*",
    "@master-harness/tool-executor-native": "workspace:*",
    "@master-harness/tool-testkit": "workspace:*",
    "@master-harness/tools": "workspace:*",
    "@master-harness/typert-protocol": "workspace:*",
    "@master-harness/user-questions": "workspace:*",
    "@master-harness/working-directory": "workspace:*",
    "@master-harness/session-persistence-jsonl": "workspace:*"
  }
}
