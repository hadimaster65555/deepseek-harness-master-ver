{
  "name": "@master-harness/experimental-ptc-runtime-python",
  "description": "CPython subprocess implementation of the Master Harness PTC execution seam",
  "version": "0.2.1-rc.3",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hadimaster65555/deepseek-harness-master-ver.git",
    "directory": "packages/experimental/ptc-runtime-python"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json"
