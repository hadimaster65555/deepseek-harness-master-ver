{
  "name": "@master-harness/experimental-browser-use-stagehand-native",
  "description": "Experimental Stagehand browser tools with separately configured native models",
  "version": "0.2.1-rc.3",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hadimaster65555/deepseek-harness-master-ver.git",
    "directory": "packages/experimental/browser-use-stagehand-native"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json",
    "./worker": {
      "types": "./lib/types/worker.d.ts",
      "default": "./lib/worker.js"
    }
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/worker.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@master-harness/cordis": "workspace:~",
    "@master-harness/agent": "workspace:*",
    "@master-harness/browser-use": "workspace:*",
    "@master-harness/system-prompt": "workspace:*",
    "@master-harness/tools": "workspace:*"
  },
  "dependencies": {
    "@browserbasehq/stagehand": "4.1.0",
    "@master-harness/experimental-browser-use-runtime": "workspace:*",
    "@master-harness/mcp-client": "workspace:*",
    "@master-harness/util-values": "workspace:*",
    "@master-harness/schemastery": "workspace:~",
    "zod": "4.4.3",
    "@master-harness/subprocess": "workspace:*",
    "@puppeteer/browsers": "3.2.2"
  },
  "devDependencies": {
    "@master-harness/cordis": "workspace:~",
    "@master-harness/cordis-plugin-include": "workspace:~",
    "@master-harness/cordis-plugin-loader": "workspace:~",
    "@master-harness/agent": "workspace:*",
    "@master-harness/agent-loop": "workspace:*",
    "@master-harness/agent-loop-testkit": "workspace:*",
    "@master-harness/attachment": "workspace:*",
    "@master-harness/attachment-local": "workspace:*",
    "@master-harness/browser-use": "workspace:*",
    "@master-harness/llm": "workspace:*",
    "@master-harness/session": "workspace:*",
    "@master-harness/session-projection": "workspace:*",
    "@master-harness/system-prompt": "workspace:*",
    "@master-harness/tool-executor-native": "workspace:*",
    "@master-harness/tool-testkit": "workspace:*",
    "@master-harness/tools": "workspace:*",
    "tsx": "^4.23.13"
  }
