{
  "name": "@master-harness/experimental-tool-worktree",
  "description": "Model tool that creates and enters a new Git worktree",
  "version": "0.2.1-rc.3",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "icon.svg",
    "locale/*.json",
    "docs",
    "lib/index.js",
    "cordis.patch.yml",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hadimaster65555/deepseek-harness-master-ver.git",
    "directory": "packages/experimental/tool-worktree"
  },
  "peerDependencies": {
    "@master-harness/cordis": "workspace:~",
    "@master-harness/tools": "workspace:*",
    "@master-harness/experimental-worktree": "workspace:*"
  },
  "devDependencies": {
    "@master-harness/cordis": "workspace:~",
    "@master-harness/cordis-plugin-include": "workspace:~",
    "@master-harness/cordis-plugin-loader": "workspace:~",
    "@master-harness/agent": "workspace:*",
    "@master-harness/agent-loop-testkit": "workspace:*",
    "@master-harness/fs-local": "workspace:*",
    "@master-harness/llm": "workspace:*",
    "@master-harness/sandbox": "workspace:*",
    "@master-harness/sandbox-local": "workspace:*",
    "@master-harness/sandbox-policy": "workspace:*",
    "@master-harness/session": "workspace:*",
    "@master-harness/session-projection": "workspace:*",
    "@master-harness/subprocess-local": "workspace:*",
    "@master-harness/system-prompt": "workspace:*",
    "@master-harness/tool-executor-native": "workspace:*",
    "@master-harness/tool-testkit": "workspace:*",
    "@master-harness/tools": "workspace:*",
    "@master-harness/working-directory": "workspace:*",
    "@master-harness/experimental-worktree": "workspace:*",
    "@master-harness/agent-loop": "workspace:*"
  },
  "icon": "./icon.svg",
  "mh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "dependencies": {
    "@master-harness/experimental-worktree": "workspace:*"
  }
}
