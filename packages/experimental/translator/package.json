{
  "name": "@master-harness/experimental-translator",
  "description": "Machine translation with reusable Session results",
  "version": "0.2.1-rc.3",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hadimaster65555/deepseek-harness-master-ver.git",
    "directory": "packages/experimental/translator"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./types": {
      "types": "./lib/types/types.d.ts",
      "default": "./lib/types/types.js"
    },
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "dependencies": {
    "@master-harness/schemastery": "workspace:~"
  },
  "peerDependencies": {
    "@master-harness/cordis": "workspace:~",
    "@master-harness/timeout": "workspace:*",
    "@master-harness/util-values": "workspace:*",
    "@master-harness/session": "workspace:*",
    "@master-harness/session-persistence": "workspace:*",
    "@master-harness/cordis-plugin-loader": "workspace:~",
    "@master-harness/llm": "workspace:*",
    "@master-harness/credentials": "workspace:*",
    "@master-harness/launch-environment": "workspace:*"
  },
  "devDependencies": {
    "@master-harness/cordis": "workspace:~",
    "@master-harness/app-boot": "workspace:*",
    "@master-harness/timeout": "workspace:*",
    "@master-harness/util-values": "workspace:*",
    "@master-harness/session": "workspace:*",
    "@master-harness/session-persistence": "workspace:*",
    "@master-harness/session-persistence-jsonl": "workspace:*",
    "@master-harness/llm": "workspace:*",
    "@master-harness/cordis-plugin-loader": "workspace:~",
    "@master-harness/credentials": "workspace:*",
    "@master-harness/launch-environment": "workspace:*",
    "@master-harness/llm-deepseek": "workspace:*",
    "@master-harness/llm-deepseek-api-key": "workspace:*",
    "@master-harness/llm-deepseek-account": "workspace:*",
    "@master-harness/deepseek-account": "workspace:*",
    "@master-harness/deepseek-llm-api-extensions": "workspace:*",
    "@master-harness/session-log-deepseek": "workspace:*",
    "@master-harness/session-query-sqlite": "workspace:*"
  }
}
