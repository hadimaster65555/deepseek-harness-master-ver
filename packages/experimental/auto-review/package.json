{
  "name": "@master-harness/experimental-auto-review",
  "description": "Per-tool LLM authorization review for the Master Harness Auto permission preset",
  "version": "0.2.1-rc.3",
  "icon": "./icon.svg",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hadimaster65555/deepseek-harness-master-ver.git",
    "directory": "packages/experimental/auto-review"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./locale/*.json": "./locale/*.json",
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml"
  },
  "files": [
    "icon.svg",
    "locale/*.json",
    "docs",
    "lib/index.js",
    "cordis.patch.yml",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@master-harness/agent": "workspace:*",
    "@master-harness/agent-instructions": "workspace:*",
    "@master-harness/llm": "workspace:*",
    "@master-harness/permission-presets": "workspace:*",
    "@master-harness/session": "workspace:*",
    "@master-harness/tools": "workspace:*",
    "@master-harness/cordis": "workspace:~",
    "@master-harness/working-directory": "workspace:*"
  },
  "dependencies": {
    "@master-harness/util-values": "workspace:*"
  },
  "devDependencies": {
    "@master-harness/agent": "workspace:*",
    "@master-harness/agent-instructions": "workspace:*",
    "@master-harness/agent-loop": "workspace:*",
    "@master-harness/agent-loop-testkit": "workspace:*",
    "@master-harness/bash-sandbox": "workspace:*",
    "@master-harness/compaction": "workspace:*",
    "@master-harness/fs-local": "workspace:*",
    "@master-harness/fs-observation-policy": "workspace:*",
    "@master-harness/fs-sandbox": "workspace:*",
    "@master-harness/llm": "workspace:*",
    "@master-harness/llm-deepseek": "workspace:*",
    "@master-harness/llm-deepseek-api-key": "workspace:*",
    "@master-harness/permission-presets": "workspace:*",
    "@master-harness/ptc-runtime-node": "workspace:*",
    "@master-harness/sandbox": "workspace:*",
    "@master-harness/sandbox-policy": "workspace:*",
    "@master-harness/session": "workspace:*",
    "@master-harness/session-projection": "workspace:*",
    "@master-harness/shell": "workspace:*",
    "@master-harness/shell-env": "workspace:*",
    "@master-harness/subagent": "workspace:*",
    "@master-harness/subprocess-local": "workspace:*",
    "@master-harness/system-prompt": "workspace:*",
    "@master-harness/tool-bash": "workspace:*",
    "@master-harness/tool-executor-native": "workspace:*",
    "@master-harness/tool-executor-ptc": "workspace:*",
    "@master-harness/tool-fs": "workspace:*",
    "@master-harness/tool-subagent": "workspace:*",
    "@master-harness/tool-testkit": "workspace:*",
    "@master-harness/tools": "workspace:*",
    "@master-harness/user-approval": "workspace:*",
    "@master-harness/cordis": "workspace:~",
    "@master-harness/working-directory": "workspace:*"
  },
  "publishConfig": {
    "access": "public"
  },
  "mh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
