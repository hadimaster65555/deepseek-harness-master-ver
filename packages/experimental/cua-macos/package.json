{
  "name": "@master-harness/experimental-cua-macos",
  "description": "macOS native provider for shared Computer Use application and window objects",
  "version": "0.2.1-rc.3",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hadimaster65555/deepseek-harness-master-ver.git",
    "directory": "packages/experimental/cua-macos"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "native/bin",
    "native/Package.swift",
    "native/Sources",
    "native/tests/swift",
    "native/tests/test_swift.py",
    "native/LICENSE.cua-driver",
    "native/upstream.json",
    "native/README.md",
    "native/README.zh.md",
    "native/protocol.schema.json",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@master-harness/cordis": "workspace:~",
    "@master-harness/computer-use": "workspace:*",
    "@master-harness/system-prompt": "workspace:*",
    "@master-harness/tools": "workspace:*",
    "@master-harness/agent": "workspace:*",
    "@master-harness/subprocess": "workspace:*",
    "@master-harness/user-questions": "workspace:*"
  },
  "dependencies": {
    "zod": "^4.4.3",
    "@master-harness/atomic-write": "workspace:*",
    "@master-harness/cua": "workspace:*"
  },
  "devDependencies": {
    "@master-harness/working-directory": "workspace:*",
    "@master-harness/cordis": "workspace:~",
    "@master-harness/cordis-plugin-include": "workspace:~",
    "@master-harness/cordis-plugin-loader": "workspace:~",
    "@master-harness/agent": "workspace:*",
    "@master-harness/agent-loop": "workspace:*",
    "@master-harness/agent-loop-testkit": "workspace:*",
    "@master-harness/attachment": "workspace:*",
    "@master-harness/attachment-local": "workspace:*",
    "@master-harness/computer-use": "workspace:*",
    "@master-harness/llm": "workspace:*",
    "@master-harness/session": "workspace:*",
    "@master-harness/session-projection": "workspace:*",
    "@master-harness/system-prompt": "workspace:*",
    "@master-harness/tool-executor-native": "workspace:*",
    "@master-harness/tool-executor-ptc": "workspace:*",
    "@master-harness/tool-testkit": "workspace:*",
    "@master-harness/tools": "workspace:*",
    "@master-harness/subprocess": "workspace:*",
    "@master-harness/subprocess-local": "workspace:*",
    "@master-harness/fs-local": "workspace:*",
    "@master-harness/llm-deepseek": "workspace:*",
    "@master-harness/ptc-runtime-node": "workspace:*",
    "@master-harness/sandbox-local": "workspace:*",
    "@master-harness/sandbox-policy": "workspace:*",
    "sharp": "^0.35.3",
    "@master-harness/ptc-runtime": "workspace:*",
    "@master-harness/user-questions": "workspace:*",
    "@master-harness/settings": "workspace:*",
    "@master-harness/app-boot": "workspace:*",
    "@master-harness/config-editor": "workspace:*",
    "@master-harness/hmr": "workspace:*",
    "@master-harness/cordis-plugin-timer": "workspace:~"
  },
  "scripts": {
    "build:native": "swift build --package-path native --configuration release"
  },
  "os": [
    "darwin"
  ]
}
