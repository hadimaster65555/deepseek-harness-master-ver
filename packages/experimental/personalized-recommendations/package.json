{
  "name": "@master-harness/personalized-recommendations",
  "description": "Personalized pages and built-in plugin recommendations offered as cards below answers",
  "version": "0.2.1-rc.3",
  "icon": "./icon.svg",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hadimaster65555/deepseek-harness-master-ver.git",
    "directory": "packages/experimental/personalized-recommendations"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "icon.svg",
    "locale/*.json",
    "docs",
    "lib/index.js",
    "cordis.patch.yml",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "dependencies": {
    "@master-harness/action-cards": "workspace:*",
    "@master-harness/client-ui-action-cards": "workspace:*",
    "@master-harness/creation-recommendations": "workspace:*",
    "@master-harness/client-ui-creation-recommendations": "workspace:*",
    "@master-harness/plugin-recommendations": "workspace:*",
    "@master-harness/client-ui-plugin-recommendations": "workspace:*"
  },
  "peerDependencies": {
    "@master-harness/cordis": "workspace:~"
  },
  "devDependencies": {
    "@master-harness/cordis": "workspace:~",
    "@master-harness/cordis-plugin-include": "workspace:~",
    "js-yaml": "^4.3.2",
    "@master-harness/cordis-plugin-timer": "workspace:~",
    "@master-harness/agent": "workspace:*",
    "@master-harness/api-remote-access": "workspace:*",
    "@master-harness/app-boot": "workspace:*",
    "@master-harness/hmr": "workspace:*",
    "@master-harness/llm": "workspace:*",
    "@master-harness/plugin-manager": "workspace:*",
    "@master-harness/session": "workspace:*",
    "@master-harness/session-projection": "workspace:*",
    "@master-harness/skill": "workspace:*",
    "@master-harness/system-prompt": "workspace:*",
    "@master-harness/tool-executor-native": "workspace:*",
    "@master-harness/tools": "workspace:*"
  },
  "mh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
