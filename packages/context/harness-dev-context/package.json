{
  "name": "@master-harness/harness-dev-context",
  "description": "Model context naming the Master Harness checkout and Web GUI URL without letting either change the system prompt",
  "version": "0.2.1-rc.3",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hadimaster65555/deepseek-harness-master-ver.git",
    "directory": "packages/context/harness-dev-context"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "dependencies": {
    "zod": "4.4.3"
  },
  "peerDependencies": {
    "@master-harness/cordis": "workspace:~",
    "@master-harness/agent": "workspace:*",
    "@master-harness/session": "workspace:*",
    "@master-harness/session-projection": "workspace:*",
    "@master-harness/system-prompt": "workspace:*"
  },
  "devDependencies": {
    "@master-harness/cordis": "workspace:~",
    "@master-harness/agent": "workspace:*",
    "@master-harness/agent-loop-testkit": "workspace:*",
    "@master-harness/llm": "workspace:*",
    "@master-harness/session": "workspace:*",
    "@master-harness/session-projection": "workspace:*",
    "@master-harness/system-prompt": "workspace:*",
    "@master-harness/web-app": "workspace:*"
  }
}
