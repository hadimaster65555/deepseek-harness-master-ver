{
  "name": "@master-harness/authorization",
  "description": "Authorization seam (ctx.authorization): plugin-owned flows that obtain a credential through a conversation with the human",
  "version": "0.2.1-rc.3",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hadimaster65555/deepseek-harness-master-ver.git",
    "directory": "packages/credentials/authorization"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./types": {
      "types": "./lib/types/types.d.ts",
      "default": "./lib/types/types.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@master-harness/credentials": "workspace:*",
    "@master-harness/llm": "workspace:*",
    "@master-harness/cordis": "workspace:~"
  },
  "devDependencies": {
    "@master-harness/credentials": "workspace:*",
    "@master-harness/llm": "workspace:*",
    "@master-harness/cordis": "workspace:~"
  }
}
