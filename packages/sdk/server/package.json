{
  "name": "@master-harness/sdk-jsonrpc-server",
  "description": "Stdio JSON-RPC server plugin for out-of-process Master Harness SDK clients",
  "version": "0.2.1-rc.3",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hadimaster65555/deepseek-harness-master-ver.git",
    "directory": "packages/sdk/server"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "dependencies": {
    "@master-harness/brand": "workspace:*",
    "@master-harness/schemastery": "workspace:~"
  },
  "peerDependencies": {
    "@master-harness/cordis": "workspace:~",
    "@master-harness/agent": "workspace:*",
    "@master-harness/attachment": "workspace:*",
    "@master-harness/llm": "workspace:*",
    "@master-harness/llm-deepseek-api-key": "workspace:*",
    "@master-harness/schedule": "workspace:*",
    "@master-harness/scope": "workspace:*",
    "@master-harness/sdk-protocol": "workspace:*",
    "@master-harness/session": "workspace:*",
    "@master-harness/subagent": "workspace:*",
    "@master-harness/user-approval": "workspace:*",
    "@master-harness/user-questions": "workspace:*",
    "@master-harness/working-directory": "workspace:*"
  },
  "devDependencies": {
    "@master-harness/cordis": "workspace:~",
    "@master-harness/cordis-plugin-loader": "workspace:~",
    "@master-harness/agent": "workspace:*",
    "@master-harness/agent-loop": "workspace:*",
    "@master-harness/agent-loop-testkit": "workspace:*",
    "@master-harness/attachment": "workspace:*",
    "@master-harness/llm": "workspace:*",
    "@master-harness/llm-deepseek-api-key": "workspace:*",
    "@master-harness/schedule": "workspace:*",
    "@master-harness/scope": "workspace:*",
    "@master-harness/sdk-protocol": "workspace:*",
    "@master-harness/session": "workspace:*",
    "@master-harness/session-persistence-jsonl": "workspace:*",
    "@master-harness/session-projection": "workspace:*",
    "@master-harness/subagent": "workspace:*",
    "@master-harness/user-approval": "workspace:*",
    "@master-harness/user-questions": "workspace:*",
    "@master-harness/working-directory": "workspace:*"
  }
}
