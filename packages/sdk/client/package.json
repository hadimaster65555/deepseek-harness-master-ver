{
  "name": "@master-harness/sdk-client",
  "description": "TypeScript client SDK for driving a Master Harness runtime subprocess over stdio JSON-RPC: the MasterHarness high-level turns API and the lower-level HarnessClient",
  "version": "0.2.1-rc.3",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hadimaster65555/deepseek-harness-master-ver.git",
    "directory": "packages/sdk/client"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "dependencies": {
    "@master-harness/mh": "workspace:*"
  },
  "peerDependencies": {
    "@master-harness/llm": "workspace:*",
    "@master-harness/sdk-protocol": "workspace:*",
    "@master-harness/session": "workspace:*",
    "@master-harness/cordis": "workspace:~"
  },
  "devDependencies": {
    "@master-harness/llm": "workspace:*",
    "@master-harness/sdk-protocol": "workspace:*",
    "@master-harness/session": "workspace:*",
    "@master-harness/cordis": "workspace:~",
    "@master-harness/experimental-translator": "workspace:*"
  }
}
