{
  "name": "@master-harness/api-session-controller",
  "description": "Session Remote commands, cold reads, and live control transport",
  "version": "0.2.1-rc.3",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hadimaster65555/deepseek-harness-master-ver.git",
    "directory": "packages/api/session-controller"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./types": {
      "types": "./lib/types/types.d.ts",
      "default": "./lib/types/types.js"
    },
    "./remote-events": {
      "types": "./lib/types/remote-events.d.ts",
      "default": "./lib/types/remote-events.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./typert": {
      "types": "./lib/typert.host.d.ts",
      "default": "./lib/typert.host.js"
    },
    "./remote": {
      "types": "./lib/typert.remote-client.d.ts",
      "default": "./lib/typert.remote-client.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "mh": {
    "client": {
      "external": [
        "@master-harness/api-gateway/client"
      ],
      "inject": [
        "@master-harness/api-gateway",
        "@master-harness/client-file-upload"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "bundle": "tsdown",
    "watch": "tsdown --watch"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/client.js",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts",
    "lib/typert.host.js",
    "lib/typert.host.d.ts",
    "lib/typert.remote-client.js",
    "lib/typert.remote-client.d.ts"
  ],
  "license": "MIT",
  "dependencies": {
    "@master-harness/brand": "workspace:*",
    "@master-harness/deque": "workspace:*",
    "@master-harness/schemastery": "workspace:~",
    "mime-types": "^3.0.2",
    "zod": "4.4.3"
  },
  "peerDependencies": {
    "@master-harness/cordis": "workspace:~",
    "@master-harness/agent": "workspace:*",
    "@master-harness/agent-default-model": "workspace:*",
    "@master-harness/agent-preset-registry": "workspace:*",
    "@master-harness/api-gateway": "workspace:*",
    "@master-harness/attachment": "workspace:*",
    "@master-harness/client-connection": "workspace:*",
    "@master-harness/client-file-upload": "workspace:*",
    "@master-harness/commands": "workspace:*",
    "@master-harness/credentials": "workspace:*",
    "@master-harness/file-reference": "workspace:*",
    "@master-harness/fs": "workspace:*",
    "@master-harness/llm": "workspace:*",
    "@master-harness/native-command": "workspace:*",
    "@master-harness/scope": "workspace:*",
    "@master-harness/session": "workspace:*",
    "@master-harness/session-persistence": "workspace:*",
    "@master-harness/session-projection": "workspace:*",
    "@master-harness/session-projection-cache": "workspace:*",
    "@master-harness/session-query": "workspace:*",
    "@master-harness/session-title": "workspace:*",
    "@master-harness/settings": "workspace:*",
    "@master-harness/skill": "workspace:*",
    "@master-harness/subagent": "workspace:*",
    "@master-harness/typert-protocol": "workspace:*",
    "@master-harness/typert-registry": "workspace:*",
    "@master-harness/util-time": "workspace:*",
    "@master-harness/util-values": "workspace:*",
    "@master-harness/util-workspace-path": "workspace:*",
    "@master-harness/workspace": "workspace:*",
    "@master-harness/working-directory": "workspace:*"
  },
  "peerDependenciesMeta": {
    "@master-harness/session-persistence": {
      "optional": true
    },
    "@master-harness/session-projection-cache": {
      "optional": true
    },
    "@master-harness/settings": {
      "optional": true
    }
  },
  "devDependencies": {
    "@master-harness/api-remote-access": "workspace:*",
    "@master-harness/cordis": "workspace:~",
    "@master-harness/agent": "workspace:*",
    "@master-harness/agent-default-model": "workspace:*",
    "@master-harness/agent-loop": "workspace:*",
