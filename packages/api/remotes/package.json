{
  "name": "@master-harness/api-remotes",
  "description": "Remote BFF assembly for application-selected Host capabilities",
  "version": "0.2.1-rc.3",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hadimaster65555/deepseek-harness-master-ver.git",
    "directory": "packages/api/remotes"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./types": {
      "types": "./lib/types/types.d.ts",
      "default": "./lib/types/types.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "mh": {
    "client": {
      "inject": [
        "@master-harness/api-gateway"
      ],
      "platform": "web",
      "immediately": true
    }
  },
  "scripts": {
    "bundle": "tsdown",
    "watch": "tsdown --watch"
  },
  "license": "MIT",
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/client.js",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts"
  ],
  "dependencies": {
    "@master-harness/deque": "workspace:*",
    "@master-harness/util-values": "workspace:*"
  },
  "peerDependencies": {
    "@master-harness/cordis": "workspace:~",
    "@master-harness/scope": "workspace:*"
  },
  "devDependencies": {
    "@master-harness/agent": "workspace:*",
    "@master-harness/agent-preset-registry": "workspace:*",
    "@master-harness/api-gateway": "workspace:*",
    "@master-harness/api-job-controller": "workspace:*",
    "@master-harness/api-session-controller": "workspace:*",
    "@master-harness/api-settings-controller": "workspace:*",
    "@master-harness/api-workspace-controller": "workspace:*",
    "@master-harness/api-workspace-files": "workspace:*",
    "@master-harness/client-connection": "workspace:*",
    "@master-harness/client-file-upload": "workspace:*",
    "@master-harness/commands": "workspace:*",
    "@master-harness/cordis-host-runner": "workspace:*",
    "@master-harness/credentials": "workspace:*",
    "@master-harness/file-reference": "workspace:*",
    "@master-harness/goal": "workspace:*",
    "@master-harness/host-plugin-inventory": "workspace:*",
    "@master-harness/llm": "workspace:*",
    "@master-harness/message-feedback": "workspace:*",
    "@master-harness/permission-presets": "workspace:*",
    "@master-harness/schedule": "workspace:*",
    "@master-harness/scope": "workspace:*",
    "@master-harness/session": "workspace:*",
    "@master-harness/session-reference": "workspace:*",
    "@master-harness/settings": "workspace:*",
    "@master-harness/subagent": "workspace:*",
    "@master-harness/typert-protocol": "workspace:*",
    "@master-harness/user-approval": "workspace:*",
    "@master-harness/user-questions": "workspace:*",
    "@master-harness/cordis": "workspace:~",
    "zod": "4.4.3",
    "@master-harness/command-feedback": "workspace:*",
    "@master-harness/api-terminal-controller": "workspace:*",
    "@master-harness/plugin-manager": "workspace:*",
    "@master-harness/plugin-market": "workspace:*",
    "@master-harness/client-ui-plugin-manager": "workspace:*",
    "@master-harness/office-to-pdf": "workspace:*",
    "@master-harness/api-account-controller": "workspace:*",
    "@master-harness/deepseek-account": "workspace:*",
    "@master-harness/client-product-analytics": "workspace:*"
  }
}
