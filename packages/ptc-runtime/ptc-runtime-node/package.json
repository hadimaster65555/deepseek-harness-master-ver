{
  "name": "@master-harness/ptc-runtime-node",
  "description": "Node PTC execution with per-call sandboxed processes or in-memory REPL state",
  "version": "0.2.1-rc.3",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hadimaster65555/deepseek-harness-master-ver.git",
    "directory": "packages/ptc-runtime/ptc-runtime-node"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json",
    "./process": {
      "types": "./lib/types/process-entry.d.ts",
      "default": "./lib/process.js"
    },
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/process.js",
    "lib/persistent-process.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@master-harness/cordis": "workspace:~",
    "@master-harness/ptc-runtime": "workspace:*",
    "@master-harness/session": "workspace:*",
    "@master-harness/timeout": "workspace:*",
    "@master-harness/fs": "workspace:*",
    "@master-harness/subprocess": "workspace:*",
    "@master-harness/sandbox": "workspace:*",
    "@master-harness/sandbox-policy": "workspace:*"
  },
  "dependencies": {
    "@master-harness/util-values": "workspace:*",
    "@master-harness/schemastery": "workspace:~",
    "birpc": "4.2.0"
  },
  "devDependencies": {
    "@master-harness/cordis": "workspace:~",
    "@master-harness/ptc-runtime": "workspace:*",
    "@master-harness/session": "workspace:*",
    "@master-harness/timeout": "workspace:*",
    "@master-harness/fs": "workspace:*",
    "@master-harness/subprocess": "workspace:*",
    "@master-harness/sandbox": "workspace:*",
    "@master-harness/sandbox-policy": "workspace:*",
    "@master-harness/fs-local": "workspace:*",
    "@master-harness/subprocess-local": "workspace:*",
    "@master-harness/session-projection": "workspace:*",
    "@master-harness/sandbox-local": "workspace:*"
  }
}
