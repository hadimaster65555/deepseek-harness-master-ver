{
  "name": "@master-harness/settings",
  "description": "Abstract user-settings seam (ctx.settings) for the Master Harness",
  "version": "0.2.1-rc.3",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hadimaster65555/deepseek-harness-master-ver.git",
    "directory": "packages/settings/settings"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./types": {
      "types": "./lib/types/types.d.ts",
      "default": "./lib/types/types.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@master-harness/cordis": "workspace:~",
    "@master-harness/brand": "workspace:*",
    "@master-harness/session": "workspace:*",
    "@master-harness/schemastery": "workspace:~"
  },
  "devDependencies": {
    "@master-harness/cordis": "workspace:~",
    "@master-harness/brand": "workspace:*",
    "@master-harness/session": "workspace:*",
    "@master-harness/schemastery": "workspace:~",
    "@master-harness/cordis-plugin-timer": "workspace:~",
    "@master-harness/app-boot": "workspace:*",
    "@master-harness/hmr": "workspace:*",
    "@master-harness/agent-default-model": "workspace:*",
    "yaml": "^2.8.1"
  },
  "dependencies": {
    "@master-harness/util-values": "workspace:*",
    "@master-harness/config-editor": "workspace:*",
    "@master-harness/cordis-plugin-loader": "workspace:~",
    "@master-harness/cosmokit": "workspace:~",
    "yaml": "^2.8.1"
  }
}
