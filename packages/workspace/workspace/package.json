{
  "name": "@master-harness/workspace",
  "description": "Workspace entity registry (ctx.workspaceRegistry): durable workspace records with validated session attachment over the domain data form for the Master Harness",
  "version": "0.2.1-rc.3",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hadimaster65555/deepseek-harness-master-ver.git",
    "directory": "packages/workspace/workspace"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./types": {
      "types": "./lib/types/types.d.ts",
      "default": "./lib/types/types.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@master-harness/cordis": "workspace:~",
    "@master-harness/session": "workspace:*",
    "@master-harness/session-persistence": "workspace:*",
    "@master-harness/storage": "workspace:*",
    "@master-harness/storage-domain": "workspace:*",
    "@master-harness/typert-protocol": "workspace:*"
  },
  "dependencies": {
    "@master-harness/brand": "workspace:*",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@master-harness/cordis": "workspace:~",
    "@master-harness/session": "workspace:*",
    "@master-harness/session-persistence": "workspace:*",
    "@master-harness/storage": "workspace:*",
    "@master-harness/storage-domain": "workspace:*",
    "@master-harness/typert-protocol": "workspace:*"
  }
}
