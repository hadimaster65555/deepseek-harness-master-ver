{
  "name": "@master-harness/ssh",
  "description": "Shared OpenSSH connection and versioned POSIX remote helper",
  "version": "0.2.1-rc.3",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hadimaster65555/deepseek-harness-master-ver.git",
    "directory": "packages/ssh/ssh"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json",
    "./helper": {
      "types": "./lib/types/helper-entry.d.ts",
      "default": "./lib/helper.js"
    },
    "./protocol": {
      "types": "./lib/types/protocol.d.ts",
      "default": "./lib/protocol.js"
    },
    "./schemas": {
      "types": "./lib/types/schemas.d.ts",
      "default": "./lib/schemas.js"
    }
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/helper.js",
    "lib/protocol.js",
    "lib/schemas.js",
    "lib/protocol-*.js",
    "lib/schemas-*.js",
    "lib/stream-security-*.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@master-harness/cordis": "workspace:~",
    "@master-harness/fs": "workspace:*",
    "@master-harness/fs-local": "workspace:*",
    "@master-harness/fs-sandbox": "workspace:*",
    "@master-harness/subprocess": "workspace:*",
    "@master-harness/subprocess-local": "workspace:*",
    "@master-harness/sandbox": "workspace:*",
    "@master-harness/sandbox-local": "workspace:*",
    "@master-harness/sandbox-policy": "workspace:*",
    "@master-harness/session-projection": "workspace:*",
    "@master-harness/brand": "workspace:*",
    "@master-harness/util-values": "workspace:*"
  },
  "dependencies": {
    "@master-harness/schemastery": "workspace:~",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@master-harness/cordis": "workspace:~",
    "@master-harness/fs": "workspace:*",
    "@master-harness/fs-local": "workspace:*",
    "@master-harness/fs-sandbox": "workspace:*",
    "@master-harness/subprocess": "workspace:*",
    "@master-harness/subprocess-local": "workspace:*",
    "@master-harness/sandbox": "workspace:*",
    "@master-harness/sandbox-local": "workspace:*",
    "@master-harness/sandbox-policy": "workspace:*",
    "@master-harness/session-projection": "workspace:*",
    "@master-harness/ptc-runtime-node": "workspace:*",
    "@master-harness/fs-ssh": "workspace:*",
    "@master-harness/subprocess-ssh": "workspace:*",
    "@master-harness/sandbox-ssh": "workspace:*",
    "@master-harness/lsp": "workspace:*",
    "@master-harness/lsp-stdio": "workspace:*",
    "@master-harness/brand": "workspace:*",
    "@master-harness/util-values": "workspace:*"
  }
}
