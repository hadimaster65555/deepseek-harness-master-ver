{
  "name": "@master-harness/bash-sandbox",
  "description": "Sandbox-consuming implementation of the Master Harness bash executor seam (confines every command via ctx.sandbox, reports denial/enforcement result facts)",
  "version": "0.2.1-rc.3",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hadimaster65555/deepseek-harness-master-ver.git",
    "directory": "packages/shell/bash-sandbox"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@master-harness/shell": "workspace:*",
    "@master-harness/bash-local": "workspace:*",
    "@master-harness/sandbox": "workspace:*",
    "@master-harness/sandbox-policy": "workspace:*",
    "@master-harness/cordis": "workspace:~"
  },
  "devDependencies": {
    "@master-harness/shell": "workspace:*",
    "@master-harness/bash-local": "workspace:*",
    "@master-harness/subprocess-local": "workspace:*",
    "@master-harness/sandbox": "workspace:*",
    "@master-harness/sandbox-local": "workspace:*",
    "@master-harness/sandbox-policy": "workspace:*",
    "@master-harness/cordis": "workspace:~",
    "@master-harness/node-addon-system": "workspace:~",
    "@master-harness/session-projection": "workspace:*"
  }
}
