{
  "name": "@master-harness/session",
  "description": "Event-sourced session store for the Master Harness",
  "version": "0.2.1-rc.3",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hadimaster65555/deepseek-harness-master-ver.git",
    "directory": "packages/core/session"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./types": {
      "types": "./lib/types/types.d.ts",
      "default": "./lib/types/types.js"
    },
    "./fork": {
      "types": "./lib/types/fork.d.ts",
      "default": "./lib/types/fork.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./surface": {
      "types": "./lib/types/surface.d.ts",
      "default": "./lib/types/surface.js"
    },
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@master-harness/scope": "workspace:*",
    "@master-harness/cordis": "workspace:~"
  },
  "devDependencies": {
    "@master-harness/scope": "workspace:*",
    "@master-harness/typert-protocol": "workspace:*",
    "@master-harness/typert-registry": "workspace:*",
    "@master-harness/cordis": "workspace:~"
  },
  "dependencies": {
    "@master-harness/llm": "workspace:*",
    "@master-harness/brand": "workspace:*",
    "@master-harness/util-values": "workspace:*"
  }
}
