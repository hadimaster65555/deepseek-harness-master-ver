{
  "name": "@master-harness/tools",
  "description": "Tool registry and execution pipeline for the Master Harness",
  "version": "0.2.1-rc.3",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hadimaster65555/deepseek-harness-master-ver.git",
    "directory": "packages/core/tools"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./presentation": {
      "types": "./lib/types/presentation.d.ts",
      "default": "./lib/types/presentation.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./pipeline": {
      "types": "./lib/types/pipeline.d.ts",
      "default": "./lib/pipeline.js"
    }
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/pipeline.js",
    "lib/shared-*.js",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@master-harness/cordis": "workspace:~",
    "@master-harness/agent": "workspace:*",
    "@master-harness/llm": "workspace:*",
    "@master-harness/scope": "workspace:*",
    "@master-harness/session": "workspace:*",
    "@master-harness/system-prompt": "workspace:*",
    "@master-harness/user-approval": "workspace:*"
  },
  "dependencies": {
    "@master-harness/brand": "workspace:*",
    "@master-harness/util-values": "workspace:*",
    "@master-harness/schemastery": "workspace:~"
  },
  "devDependencies": {
    "@master-harness/cordis": "workspace:~",
    "@master-harness/agent": "workspace:*",
    "@master-harness/llm": "workspace:*",
    "@master-harness/scope": "workspace:*",
    "@master-harness/session": "workspace:*",
    "@master-harness/session-projection": "workspace:*",
    "@master-harness/system-prompt": "workspace:*",
    "@master-harness/tool-executor-native": "workspace:*",
    "@master-harness/tool-testkit": "workspace:*",
    "@master-harness/user-approval": "workspace:*",
    "@master-harness/agent-loop-testkit": "workspace:*"
  }
}
