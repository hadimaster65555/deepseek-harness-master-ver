# Copy to production.env in the same machine configuration directory and fill in the values.
MH_DESKTOP_APP_ID=com.masterharness.mh
MH_DESKTOP_AUTO_UPDATE_ENV=production
MH_DESKTOP_MANDATORY_UPDATE_PROD_ORIGIN=
MH_DESKTOP_MANDATORY_UPDATE_CONFIG='{}'
# MH_DESKTOP_WINDOWS_SIGNATURE_CACHE_DIR=
MH_DESKTOP_WINDOWS_SIGNATURE_CACHE_CONCURRENCY=4
# Installer archive compression (0-9).
MH_DESKTOP_WINDOWS_COMPRESSION_LEVEL=3
