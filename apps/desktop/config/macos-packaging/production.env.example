# Copy to production.env and configure the production service before selecting this preset.
MH_DESKTOP_APP_ID=com.masterharness.mh
MH_DESKTOP_AUTO_UPDATE_ENV=production
MH_DESKTOP_MANDATORY_UPDATE_PROD_ORIGIN=
MH_DESKTOP_MACOS_PACK_CONCURRENCY=4
MH_DESKTOP_MACOS_ZIP_COMPRESSION_LEVEL=3
MH_DESKTOP_MACOS_DOWNLOAD_PROXY=
MH_DESKTOP_MACOS_NOTARIZATION_PROXY=
# Optional absolute private directory; setup fills this in for machine presets. Omit to use checkout-local storage.
# MH_DESKTOP_MACOS_SIGNATURE_CACHE_DIR=
